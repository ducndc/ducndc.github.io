---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { slugify } from '../../utils';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsByCategory = posts.reduce<Record<string, typeof posts>>((acc, post) => {
	const category = post.data.category;
	(acc[category] ??= []).push(post);
	return acc;
}, {});

// Sắp xếp chủ đề theo bảng chữ cái tiếng Việt
const categories = Object.keys(postsByCategory).sort((a, b) =>
	a.localeCompare(b, 'vi'),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<style>
			.page-banner {
				background: var(--space);
				color: #fff;
				padding: 5rem 1.5rem 3.5rem;
				border-bottom: 4px solid var(--accent);
			}

			.page-banner > div {
				max-width: 1200px;
				margin: 0 auto;
			}

			.page-banner h1 {
				color: #fff;
				font-size: clamp(3rem, 8vw, 6rem);
				font-weight: 900;
				margin: 0.75rem 0 1rem;
			}

			.page-banner p:not(.eyebrow) {
				color: #ccc;
				font-size: 1.15rem;
				max-width: 55ch;
				margin: 0;
			}

			.blog-layout {
				width: auto;
				max-width: 1200px;
				margin: 0 auto;
				padding: 3.5rem 1.5rem;
			}

			.year-section {
				margin-bottom: 2.5rem;
			}

			.year-heading {
				font-family: var(--font-mono);
				font-size: 0.9rem;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--accent);
				margin-bottom: 0.5rem;
				padding-bottom: 0.6rem;
				border-bottom: 2px solid #000;
				scroll-margin-top: 90px;
			}

			.count {
				font-weight: 400;
				opacity: 0.6;
			}

			.posts-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-item a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				padding: 0.9rem 0.75rem;
				text-decoration: none;
				border-bottom: 1px solid #e5e5e5;
				border-left: 4px solid transparent;
				transition: background 0.15s ease, border-color 0.15s ease;
			}

			.post-item a:hover {
				background: #f6f6f6;
				border-left-color: var(--accent);
			}

			.post-item a:hover .post-title {
				text-decoration: underline;
				text-underline-offset: 4px;
			}

			.post-title {
				font-size: 1.25rem;
				font-weight: 700;
				color: rgb(var(--black));
				transition: color 0.15s ease;
				line-height: 1.4;
			}

			.post-date {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				text-transform: uppercase;
				color: #666;
				white-space: nowrap;
				flex-shrink: 0;
			}

			@media (max-width: 480px) {
				.post-item a {
					flex-direction: column;
					gap: 0.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<section class="page-banner">
			<div>
				<p class="eyebrow">{posts.length} articles · {categories.length} topics</p>
				<h1>Blog</h1>
				<p>Notes from the field on Wi-Fi, embedded Linux, networking, and the occasional poem.</p>
			</div>
		</section>
		<main class="blog-layout">
			{categories.map((category) => (
				<div class="year-section">
					<h2 class="year-heading" id={slugify(category)}>
						{category} <span class="count">({postsByCategory[category].length})</span>
					</h2>
					<ul class="posts-list">
						{postsByCategory[category].map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</main>
		<Footer />
	</body>
</html>