  "cards": [
    {
      "dot": "cyan",
      "title": "Fronthaul isolation",
      "items": [
        "Both APs map the Guest SSID to the same VLAN 30 trunk; AP 1 additionally sets ap_isolate=1 so guest-to-guest traffic never leaves the radio."
      ]
    },
    {
      "dot": "rose",
      "title": "Guest never reaches the LAN",
      "items": [
        "nftables explicitly drops guest \u2192 corporate-LAN/management traffic \u2014 that's a denied path on the topology, not a working data flow."
      ]
    },
    {
      "dot": "amber",
      "title": "Control plane sits beside the firewall, not inside it",
      "items": [
        "The portal controller only talks to nftables over netlink to add/remove allow-list set elements; it never forwards packets itself."
      ]
    }
  ]
