---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="brand">
			<span class="mark" aria-hidden="true">
				<img src="/favicon.ico" alt="" width="32" height="32" />

			</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1.5rem;
		background: var(--space);
		border-bottom: 1px solid #2a2a2a;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1440px;
		margin: 0 auto;
		height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: #fff;
		text-decoration: none;
	}
	.mark {
		display: flex;
	}
	.mark img {
		margin: 0;
		/* favicon.ico is a black star; invert it to white for the black header */
		filter: invert(1);
	}
	.brand-name {
		font-size: 0.95rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
		height: 100%;
	}
	.internal-links :global(a) {
		display: flex;
		align-items: center;
		box-sizing: border-box;
		height: 100%;
		padding: 3px 1rem 0;
		color: #fff;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		border-bottom: 3px solid transparent;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.internal-links :global(a:hover) {
		color: #fff;
		border-bottom-color: #555;
	}
	.internal-links :global(a.active) {
		border-bottom-color: var(--accent);
	}
	@media (max-width: 640px) {
		header {
			padding: 0 0.75rem;
		}
		.brand-name {
			display: none;
		}
		.internal-links :global(a) {
			padding: 0 0.7rem;
		}
	}
</style>
