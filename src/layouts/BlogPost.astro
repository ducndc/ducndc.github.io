---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import "katex/dist/katex.min.css";

type Props = Omit<CollectionEntry<'blog'>['data'], 'category'> & { category?: string };

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;
---

<html lang="en">
<head>
	<BaseHead title={title} description={description} />
	<style>
		.prose :global(table) {
			width: 100%;
			border-collapse: collapse;
		}

		.prose :global(th),
		.prose :global(td) {
			padding: 0.6rem 0.75rem;
			text-align: left;
			vertical-align: top;
			border-bottom: 1px solid rgba(0, 0, 0, 0.12);
		}

		.prose :global(thead th) {
			border-bottom: 2px solid rgba(0, 0, 0, 0.25);
		}
		/* ===== Layout ===== */
		.layout {
			display: grid;
			grid-template-columns: 260px 1fr;
			gap: 3rem;
			width: auto;
			max-width: 1440px;
			margin: 0 auto;
			padding: 2.5rem 1.5rem;
		}

		/* ===== TOC ===== */
		.toc {
			position: sticky;
			top: 100px;
			height: fit-content;
			font-size: 14px;
			color: rgb(var(--gray));
			padding: 0 0 0 1rem;
			border-left: 1px solid #ddd;
		}

		.toc-title {
			font-weight: bold;
			margin-bottom: 0.5rem;
			font-family: var(--font-mono);
			font-size: 12px;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--accent);
		}

		.toc nav {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		.toc :global(.toc a) {
			display: block;
			padding: 0.35rem 0.5rem;
			text-decoration: none;
			color: inherit;
			border-left: 3px solid transparent;
			transition: all 0.2s ease;
		}

		.toc :global(.toc a:hover) {
			background: rgba(0,0,0,0.05);
		}

		.toc :global(.toc a.active) {
			color: black;
			font-weight: 700;
			border-left: 3px solid var(--accent);
			background: rgba(0,0,0,0.04);
		}

		.toc :global(.toc a.h3) {
			padding-left: 1.5rem;
			font-size: 13px;
			opacity: 0.85;
		}

		/* ===== Content ===== */
		.content {
			min-width: 0;
		}

		.hero-image img {
			display: block;
			margin: 0 auto;
			width: 100%;
			max-width: 1200px;
		}

		.prose {
			width: 100%;
			max-width: 1200px;
			margin: auto;
			padding: 1.5rem;
			line-height: 1.75;
			font-size: 18px;
			color: rgb(var(--gray-dark));
		}

		.prose p {
			max-width: 70ch;
		}

		/* Justified body text; hyphenation keeps word spacing even */
		.prose :global(p),
		.prose :global(li),
		.prose :global(blockquote) {
			text-align: justify;
			text-justify: inter-word;
			hyphens: auto;
		}

		.prose img {
			width: 100%;
			border-radius: 8px;
			margin: 1.5rem 0;
		}

		.prose pre {
			max-width: 100%;
			overflow-x: auto;
			padding: 1rem;
			border-radius: 8px;
		}

		.title {
			margin-bottom: 2rem;
		}

		.title h1 {
			font-size: clamp(2.2rem, 5vw, 3.75rem);
			font-weight: 900;
			margin: 0.75rem 0 1rem;
		}

		.title .description {
			font-size: 1.25rem;
			color: #444;
			max-width: 60ch;
		}

		.date {
			font-family: var(--font-mono);
			font-size: 0.85rem;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: #666;
		}

		.title hr {
			border-top: 4px solid var(--accent);
			width: 80px;
			margin: 1.5rem 0 0;
		}

		.prose :global(h2),
		.prose :global(h3) {
			margin-top: 2.5rem;
		}

		/* ===== Mobile ===== */
		@media (max-width: 1024px) {
			.layout {
				grid-template-columns: 1fr;
			}
			.toc {
				display: none;
			}
		}
	</style>
</head>

<body>
	<Header />

	<main class="layout">
		<!-- TOC -->
		<aside class="toc">
			<div class="toc-title">Table of Contents</div>
			<nav id="toc"></nav>
		</aside>

		<!-- Content -->
		<article class="content">
			<div class="hero-image">
				{heroImage && <Image width={1600} height={800} src={heroImage} alt="" />}
			</div>

			<div class="prose">
				<div class="title">
					{category && <p class="eyebrow">{category}</p>}
					<h1>{title}</h1>
					{description && description !== title && <p class="description">{description}</p>}
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div>
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<hr />
				</div>

				<slot />
			</div>
		</article>
	</main>

	<Footer />

	<script>
	document.addEventListener("DOMContentLoaded", () => {
		const toc = document.getElementById("toc");
		const headings = Array.from(document.querySelectorAll(".prose h2, .prose h3"));

		if (!toc || headings.length === 0) return;

		/* ===== Build TOC ===== */
		headings.forEach((heading) => {
			const text = heading.textContent.trim();

			const id = text
				.toLowerCase()
				.normalize("NFD")
				.replace(/[\u0300-\u036f]/g, "")
				.replace(/[^a-z0-9]+/g, "-");

			heading.id = id;

			const link = document.createElement("a");
			link.href = "#" + id;
			link.textContent = text;

			if (heading.tagName === "H3") {
				link.classList.add("h3");
			}

			toc.appendChild(link);
		});

		const links = Array.from(document.querySelectorAll(".toc a"));

		/* ===== Smooth scroll ===== */
		links.forEach(link => {
			link.addEventListener("click", (e) => {
				e.preventDefault();

				const target = document.querySelector(link.getAttribute("href"));
				if (!target) return;

				const yOffset = -80;
				const y = target.getBoundingClientRect().top + window.scrollY + yOffset;

				window.scrollTo({ top: y, behavior: "smooth" });
			});
		});

		/* ===== Scroll Spy ===== */
		let activeId = null;

		const setActive = (id) => {
			if (activeId === id) return;

			activeId = id;
			links.forEach(link => {
				link.classList.toggle(
					"active",
					link.getAttribute("href") === "#" + id
				);
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter(e => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

				if (visible.length > 0) {
					setActive(visible[0].target.id);
				}
			},
			{
				rootMargin: "-30% 0px -60% 0px",
				threshold: [0, 1]
			}
		);

		headings.forEach(h => observer.observe(h));
	});
	</script>
</body>
</html>